# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# CoreML artifacts (large, generated by export -- never checked in; see the
# Quickstart, everyone runs `uv run gemma-export` themselves)
*.mlirbc
*.mlpackage
*.mlmodelc
*.mlmodelc.src-sha256
# ...and hand-made copies of them. `*.mlpackage` only matches names *ending*
# in .mlpackage, so a backup like `gemma4-e2b.mlpackage.block32.bak` (2.7 GB)
# slips through and is one `git add .` away from being committed.
*.mlpackage.*
*.mlmodelc.*
*.bak
*.bak/

# IDE / editor
.cursor/debug-*.log
*.xcuserstate
.swiftpm/
xcuserdata/
.DS_Store

# Downloaded at build time (31 MB HuggingFace tokenizer vocab)
ios/GemmaChat/GemmaChat/Resources/tokenizer.json
.vscode/
